#!/bin/bash
# Quick test runner for local development
# Usage:
#   ./test-run unit tests/unit/test_security.py
#   ./test-run integration tests/integration/test_auth_endpoints.py
#   ./test-run e2e tests/e2e/test_auth_to_cart_journey.py
#   ./test-run all

set -e

TEST_TYPE="${1:-unit}"
TEST_FILE="${2:-.}"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

activate_venv() {
    if [ ! -d ".venv" ]; then
        echo -e "${YELLOW}Virtual env not found${NC}"
        exit 1
    fi
    source .venv/bin/activate
}

echo -e "${BLUE}=== Running $TEST_TYPE tests ===${NC}"

case "$TEST_TYPE" in
    unit)
        activate_venv
        echo -e "${GREEN}✓ Venv activated${NC}"
        python -m pytest -q --tb=short "$TEST_FILE" -W ignore::DeprecationWarning
        ;;
    integration)
        activate_venv
        echo -e "${GREEN}✓ Venv activated${NC}"
        python -m pytest -q --tb=short "$TEST_FILE" -W ignore::DeprecationWarning
        ;;
    e2e)
        activate_venv
        echo -e "${GREEN}✓ Venv activated${NC}"
        E2E_BASE_URL="${E2E_BASE_URL:-http://localhost}"
        echo -e "${BLUE}Using E2E base URL: ${E2E_BASE_URL}${NC}"

        if docker info >/dev/null 2>&1; then
            echo -e "${BLUE}Starting infrastructure (db, redis, api)...${NC}"
            docker compose -f docker-compose.yml -f docker-compose.test.yml up -d db redis api
            sleep 5
            until [ "$(docker inspect -f '{{.State.Health.Status}}' advanced-ecommerce-api-1 2>/dev/null)" = "healthy" ]; do
                echo -e "${YELLOW}waiting for api...${NC}"
                sleep 2
            done
            echo -e "${GREEN}✓ API healthy${NC}"
        else
            echo -e "${YELLOW}Docker daemon not available. Skipping container startup.${NC}"
            if curl -fsS "${E2E_BASE_URL}/docs" >/dev/null 2>&1; then
                echo -e "${GREEN}✓ Existing API detected at ${E2E_BASE_URL}${NC}"
            else
                echo -e "${YELLOW}No reachable API at ${E2E_BASE_URL}.${NC}"
                echo -e "${YELLOW}Start Docker Desktop or run API separately, then retry.${NC}"
                exit 1
            fi
        fi
        E2E_BASE_URL="${E2E_BASE_URL}" python -m pytest -q --tb=short "$TEST_FILE" -W ignore::DeprecationWarning
        ;;
    all)
        echo -e "${BLUE}Running unit tests...${NC}"
        "$0" unit tests/unit
        echo -e "${BLUE}Running integration tests...${NC}"
        "$0" integration tests/integration
        echo -e "${BLUE}Running E2E tests...${NC}"
        "$0" e2e tests/e2e
        ;;
    *)
        echo "Usage: $0 {unit|integration|e2e|all} [test_file]"
        exit 1
        ;;
esac

echo -e "${GREEN}✓ Tests completed${NC}"
